# Environment variables for Universal FastAPI Foundation
# Copy this file to .env and fill in the appropriate values

# Application
APP_NAME=Universal FastAPI Foundation
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=local

# API
API_V1_STR=/api/v1

# Database - Individual components
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=universal_fastapi_foundation

# Database - Full DSN (optional, overrides individual components if set)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
# DATABASE_URL_SYNC=postgresql://user:password@localhost/dbname

# Security
SECRET_KEY=change-me-in-prod-a-strong-secret-key-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30  # 30 minutes (short-lived access token)
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=RS256
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=universal-fastapi-foundation
JWT_AUDIENCE=universal-fastapi-foundation-users
JWT_LEEWAY_SECONDS=10

# Email
EMAIL_PROVIDER=log  # smtp, brevo, sendgrid, ses, log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False

# Brevo (Sendinblue) transactional email
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# SMS
SMS_PROVIDER=log  # twilio, log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS OTP settings
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRE_MINUTES=10
SMS_OTP_RATE_LIMIT_WINDOW=60

# Outbound HTTP client
HTTP_CLIENT_TIMEOUT=30
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_BASE_URL=
HTTP_CLIENT_DEFAULT_HEADERS={}

# Email notifications
NOTIFICATIONS_FROM_EMAIL=noreply@example.com
NOTIFICATIONS_FROM_NAME=Universal FastAPI Foundation

# Storage
STORAGE_PROVIDER=local  # local, minio, s3, gcs, azure
LOCAL_STORAGE_PATH=./uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False

# AI Providers
AI_PROVIDER=openai  # openai, anthropic, google, groq, mistral
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Observability
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds
RATE_LIMIT_STRATEGY=fixed-window  # fixed-window, sliding-window, token-bucket

# CORS (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File upload limits
MAX_UPLOAD_SIZE=10485760  # 10 MB

# Encryption key for field-level encryption
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Tenant GUC name for multi-tenancy (PostgreSQL specific)
TENANT_GUC_NAME=app.tenant_id